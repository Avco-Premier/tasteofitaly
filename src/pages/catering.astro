---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import PageHero from '../components/PageHero.astro';
import MenuSections from '../components/MenuSections.astro';
import Reviews from '../components/Reviews.astro';
import { frontmatter as fm, Content } from '../copy/catering.md';
import { biz, telHref } from '../lib/site';
import { getMenu, money } from '../lib/menu';
import { pageHero, photos } from '../lib/photos';

// Delete this page (and "catering" from site.nav) if the client does not cater.
// v4 catering: hero, package cards (a short catering menu) or the full catering menu, the story,
// a private-events band (only when the client hosts them and there's a photo), and "Request a quote".
// The design's quote form needs a form backend; until one is wired, the quote box is call / email.
const c = biz.catering;
const hero = pageHero('catering');
// When catering is ordered from the regular menu, link to it instead of printing the whole menu twice.
const ownMenu = c.menuFile !== 'main';
const menu = ownMenu ? getMenu(c.menuFile) : null;
const items = menu ? menu.subcategories.flatMap((s) => s.items.map((i) => ({ ...i, section: s.name }))) : [];
const asPackages = items.length > 0 && items.length <= 9;
const area = c.serviceArea.length ? c.serviceArea : biz.serviceArea;
const cateringPhone = (biz.additionalPhones as { label: string; phone: string; display: string }[]).find((p) => /catering/i.test(p.label));
const orderPhone = cateringPhone ? { href: telHref(cateringPhone.phone), display: cateringPhone.display } : { href: telHref(), display: biz.phoneDisplay };
const callVerb = cateringPhone && /text/i.test(cateringPhone.label) ? 'Call or text' : 'Call';
// Only a real address gets a mailto: link (catering.contact is sometimes a sentence like 'Call us to plan an order').
const email = [c.contact, biz.email].find((e) => e && /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(e.trim()));
const facts = [
  c.leadTime && ['Order ahead', c.leadTime],
  c.minimum && ['Minimum', c.minimum],
  area.length && ['Areas we cater', area.join(', ')],
  c.deliveryNote && [/set[- ]?up/i.test(c.deliveryNote) ? 'Delivery & setup' : /pick ?up/i.test(c.deliveryNote) ? 'Pickup & delivery' : 'Delivery', c.deliveryNote],
  (c as any).days && ['Days & times', (c as any).days],
  (c as any).ordering && ['How to order', (c as any).ordering],
  (c as any).payment && ['Payment', (c as any).payment],
  (c as any).cancellation && ['Changes & cancellations', (c as any).cancellation],
].filter(Boolean) as [string, string][];
const unit = (d = '') => (/per (person|guest)/i.test(d) ? ' per guest' : /per dozen|a dozen/i.test(d) ? ' a dozen' : /per tray/i.test(d) ? ' a tray' : '');
const parts = (d = '') => d.split(/[,;]\s*|\s+—\s+/).map((x) => x.trim()).filter((x) => x && !/^per (person|guest|dozen|tray)$/i.test(x)).slice(0, 6);
const bandPhoto = photos.find((p) => p !== hero && ['catering', 'interior'].includes(p.subject));
---
<Base kind="catering" title={fm.title} description={fm.description} crumbs={[{ name: 'Catering', path: '/catering/' }]} image={hero?.src}>
  <PageHero h1={fm.h1} lede={fm.lede} photo={hero} crumbs={[{ name: 'Catering', path: '/catering/' }]}>
    <p class="actions center">
      <a class="btn btn-cream" href="#quote">Request a quote</a>
      <a class="btn btn-ghost-light" href={orderPhone.href}>{callVerb} {orderPhone.display}</a>
    </p>
  </PageHero>

  {asPackages && (
    <section class="section" aria-labelledby="catering-menu-h">
      <div class="wrap">
        <h2 id="catering-menu-h" class="centered-h">Catering menu</h2>
        <ul class="package-grid">
          {items.map((i) => (
            <li class="package">
              <span class="tag">{i.section}</span>
              <h3>{i.name}</h3>
              <span class="price">{money(i.price)}{unit(i.description)}</span>
              <span class="rule" aria-hidden="true"></span>
              {parts(i.description).length > 0 && <ul>{parts(i.description).map((x) => <li>{x}</li>)}</ul>}
              <a class="btn btn-primary" href="#quote">Request a quote</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  {menu && !asPackages && (
    <section class="section menu-page" aria-labelledby="catering-menu-h">
      <div class="wrap">
        <h2 id="catering-menu-h" class="centered-h">Catering menu</h2>
        <MenuSections menu={menu} idPrefix="catering-" headingLevel={3} />
      </div>
    </section>
  )}

  <section class="section"><div class="wrap prose story"><Content /></div></section>

  {biz.services.privateEvents && bandPhoto && (
    <section class="band" aria-labelledby="private-h">
      <Img photo={bandPhoto} sizes="100vw" widths={[640, 960, 1280, 1920]} class="cover" />
      <div>
        <h2 id="private-h">Private events</h2>
        <p>Call <a href={telHref()}>{biz.phoneDisplay}</a> to plan yours</p>
      </div>
    </section>
  )}

  <section id="quote" class="section quote-box" aria-labelledby="quote-h">
    <div class="narrow">
      <h2 id="quote-h">Request a quote</h2>
      <p>Tell us your date, how many guests, and whether you'll pick up{biz.services.delivery ? ' or need delivery' : ''}.</p>
      <div class="card">
        {facts.length > 0 && <dl class="fact-list">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
        <p class="actions center">
          <a class="btn btn-primary" href={orderPhone.href}>{callVerb} {orderPhone.display}</a>
          {email && <a class="btn btn-ghost" href={`mailto:${email}?subject=Catering%20request`}>Email a request</a>}
          {!ownMenu && <a class="btn btn-ghost" href="/menu/">See the menu</a>}
        </p>
      </div>
    </div>
  </section>
  <Reviews heading="From our catering customers" context="catering" />
</Base>
