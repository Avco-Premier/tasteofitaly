---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/client-override.css';
import gelasioUrl from '../styles/fonts/gelasio-latin.woff2?url';
import gloockUrl from '../styles/fonts/gloock-latin.woff2?url';
import damionUrl from '../styles/fonts/damion-latin.woff2?url';
import figtreeUrl from '../styles/fonts/figtree-latin.woff2?url';
import youngSerifUrl from '../styles/fonts/young-serif-latin.woff2?url';
import archivoUrl from '../styles/fonts/archivo-latin.woff2?url';
import antonUrl from '../styles/fonts/anton-latin.woff2?url';
import loraUrl from '../styles/fonts/lora-latin.woff2?url';
import bebasUrl from '../styles/fonts/bebas-neue-latin.woff2?url';
import barlowUrl from '../styles/fonts/barlow-condensed-800-latin.woff2?url';
import dmSansUrl from '../styles/fonts/dm-sans-latin.woff2?url';
import { biz, site, abs, themeVars, variant, serviceBits, telHref } from '../lib/site';
import { graph, type PageKind, type Crumb } from '../lib/schema';
import { photoFor, photos, brandImage } from '../lib/photos';

interface Props {
  kind: PageKind;
  title: string;
  description: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  noindex?: boolean;
  dish?: string;
  area?: string;
}
const { kind, title, description, crumbs = [], image, noindex = false, dish, area } = Astro.props;

const path = Astro.url.pathname;
const canonical = abs(path);

const ogSource = image ?? photoFor('social')?.src ?? photoFor('home-hero')?.src;
const ogAlt = photos.find((p) => p.src === ogSource)?.alt ?? `${biz.name} in ${biz.address.locality}, ${biz.address.region}`;
// 1200×630 (1.91:1), the size social cards and search previews expect.
const og = ogSource ? await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : null;
const ogUrl = og ? abs(og.src) : undefined;

const logo = brandImage(biz.logo);
const logoUrl = logo ? abs((await getImage({ src: logo, ...(logo.format === 'svg' ? {} : { width: 512, format: 'png' }) })).src) : undefined;

const rank = (p: (typeof photos)[number]) =>
  p.use?.includes('visit-hero') || p.subject === 'exterior' ? 0 : p.use?.includes('home-hero') ? 1 : p.subject === 'interior' ? 2 : 3;
const schemaImages = await Promise.all(
  photos.filter((p) => ['exterior', 'interior', 'dish'].includes(p.subject)).sort((a, b) => rank(a) - rank(b)).slice(0, 4)
    .map(async (p) => abs((await getImage({ src: p.src, width: 1200, format: 'jpg', quality: 80 })).src)),
);

const ld = graph({ kind, path, title, description, crumbs, imageUrl: ogUrl, logoUrl, imageUrls: schemaImages, dish, area });
// Preload the two faces above the fold (and the script wordmark unless the header shows a logo image), so text never reflows.
const FONTS: Record<string, string[]> = {
  classic: [gelasioUrl, gloockUrl, ...((site as any).headerLogo === 'image' && logo ? [] : [damionUrl])],
  market: [figtreeUrl, youngSerifUrl],
  bold: [archivoUrl, antonUrl],
  slice: [loraUrl, bebasUrl],
  corner: [dmSansUrl, barlowUrl],
};
const fonts = FONTS[variant] ?? FONTS.classic;
// Market's announcement bar: the services in one line, linked to ordering (or the menu).
const announce = variant === 'market' ? serviceBits() : [];
// Corner's top bar: the street address (to Google Maps) and the phone, the way a storefront awning reads.
const streetBar = variant === 'corner';
const theme = themeVars();
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---
<!doctype html>
<html lang={site.language} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={biz.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={ogUrl} />}
    {og && <meta property="og:image:width" content={String(og.attributes.width)} />}
    {og && <meta property="og:image:height" content={String(og.attributes.height)} />}
    {og && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {biz.apps.iosAppId && <meta name="apple-itunes-app" content={`app-id=${biz.apps.iosAppId}`} />}
    {site.searchConsoleVerification && <meta name="google-site-verification" content={site.searchConsoleVerification} />}
    {theme && <style is:inline set:html={theme} />}
    {fonts.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    {site.analytics.ga4Id && <script is:inline src="/ga-init.js" data-ga-id={site.analytics.ga4Id} defer></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {announce.length > 0 && (
      <div class="announce"><p class="wrap">{announce.map((b, i) => <><span class="nb">{b}</span>{i < announce.length - 1 ? ' · ' : ' '}</>)}<a href={biz.ordering.url || '/menu/'} rel={biz.ordering.url ? 'noopener' : undefined}>{biz.ordering.url ? 'Order now' : 'See the menu'} <span aria-hidden="true">→</span></a></p></div>
    )}
    {streetBar && (
      <div class="announce street-bar"><p class="wrap"><a href={biz.google.mapsUrl || '/visit/'} rel={biz.google.mapsUrl ? 'noopener' : undefined}>{biz.address.street} · {biz.address.locality}, {biz.address.region}</a><a class="street-phone" href={telHref()}>{biz.phoneDisplay}</a></p></div>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ActionBar />
  </body>
</html>
