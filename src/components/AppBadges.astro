---
import { site } from '../data/site';
interface Props { compact?: boolean; label?: string; }
const { compact = false, label = 'Get the Taste of Italy app' } = Astro.props;
---
<div class:list={['download-group', compact && 'compact']}>
  <p>{label}</p>
  <div class="app-badges" aria-label="Download the Taste of Italy app">
    <a class="app-badge" href={site.appStore} target="_blank" rel="noopener" aria-label="Download Taste of Italy on the App Store">
      <svg viewBox="0 0 30 36" aria-hidden="true"><path fill="currentColor" d="M24.4 18.9c0-4.5 3.7-6.7 3.9-6.8-2.1-3.1-5.4-3.5-6.6-3.6-2.8-.3-5.4 1.6-6.8 1.6-1.4 0-3.6-1.6-5.9-1.5-3 0-5.8 1.8-7.3 4.5-3.1 5.4-.8 13.4 2.2 17.8 1.5 2.1 3.2 4.5 5.5 4.4 2.2-.1 3-1.4 5.7-1.4s3.4 1.4 5.8 1.3c2.4 0 3.9-2.1 5.3-4.2 1.7-2.5 2.4-4.9 2.4-5.1-.1 0-4.2-1.6-4.2-7zM19.9 5.6C21.1 4.2 21.9 2.2 21.7.2c-1.7.1-3.8 1.1-5 2.5-1.1 1.3-2.1 3.3-1.8 5.2 1.9.1 3.8-1 5-2.3z"/></svg>
      <span><small>Download on the</small><strong>App Store</strong></span>
    </a>
    <a class="app-badge" href={site.playStore} target="_blank" rel="noopener" aria-label="Get Taste of Italy on Google Play">
      <svg viewBox="0 0 30 34" aria-hidden="true"><path fill="#34a853" d="M2.2 1.1c-.7.4-1.2 1.2-1.2 2.3v27.2c0 1 .4 1.8 1.1 2.2l14.7-15.9L2.2 1.1z"/><path fill="#4285f4" d="m16.8 16.9 4.3-4.6L4.1.9C3.4.5 2.8.6 2.2 1.1l14.6 15.8z"/><path fill="#fbbc04" d="m16.8 16.9 4.3 4.6 5.8-3.4c1.7-1 1.7-2.6 0-3.6l-5.8-3.4-4.3 5.8z"/><path fill="#ea4335" d="M2.1 32.8c.6.5 1.3.5 2 .1l17-11.4-4.3-4.6L2.1 32.8z"/></svg>
      <span><small>GET IT ON</small><strong>Google Play</strong></span>
    </a>
  </div>
</div>
