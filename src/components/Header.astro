---
import { Image } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import { biz, site, telHref, NAV_LABELS } from '../lib/site';
import { brandImage } from '../lib/photos';

// Centered wordmark over an uppercase nav, phone on the left, Order on the right (desktop);
// a compact bar with a no-JS <details> menu on phones, where Call and Order live in the bottom action bar.
// The header shows the client's logo image only when site.headerLogo is "image" (most logos aren't made for cream-on-green).
const logo = brandImage(biz.logo);
const useLogo = Boolean(logo) && (site as any).headerLogo === 'image';
const current = Astro.url.pathname;
const links = site.nav.map((key) => ({ href: `/${key}/`, label: NAV_LABELS[key] ?? key }));
const instagram = (biz.social as Record<string, string>).instagram;
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      {useLogo && logo ? <><Image src={logo} alt="" height={64} loading="eager" /><span class="brand-name">{biz.name}</span></> : <Wordmark />}
    </a>
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      {instagram?.startsWith('http') && (
        <a class="header-social" href={instagram} rel="noopener" aria-label={`${biz.name} on Instagram`}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
        </a>
      )}
    </nav>
    <a class="header-phone" href={telHref()}>{biz.phoneDisplay}</a>
    {biz.ordering.url
      ? <a class="btn btn-cream header-order" href={biz.ordering.url} rel="noopener">{biz.ordering.label || 'Order online'}</a>
      : <a class="btn btn-cream header-order" href="/menu/">See the menu</a>}
    <details class="nav-toggle">
      <summary><span class="burger" aria-hidden="true"></span><span class="sr-only">Site menu</span></summary>
      <nav aria-label="Primary (mobile)">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li><a href={telHref()}>Call {biz.phoneDisplay}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
